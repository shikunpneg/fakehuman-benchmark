{
  "id": "patience",
  "title": "耐心测试——追问耗尽评测",
  "version": "v0.2",
  "description": "测量模型在用户反复追问具体细节或叠加追问\"为什么\"时能保持多久的耐心。两种测试模式：1) deepseek风格：追问具体字词发音；2) 渐进追问：不断追问\"为什么\"+上一回答内容。",
  "format_types": ["syllable_asking", "why_chain"],
  "items": [
    {
      "id": "pat-01",
      "format": "syllable_asking",
      "topic": "量子力学",
      "level": "short",
      "rounds": 4,
      "turns": [
        {"role": "user", "content": "请给我介绍一下量子力学"},
        {"role": "user", "content": "你说的\"量子\"中的第一个字\"量\"具体是什么意思？"},
        {"role": "user", "content": "那\"子\"这个字呢？"},
        {"role": "user", "content": "你说\"力学\"中的\"学\"是指什么？"}
      ],
      "expected_after_rounds": "snarky_or_terminate"
    },
    {
      "id": "pat-02",
      "format": "syllable_asking",
      "topic": "机器学习",
      "level": "medium",
      "rounds": 6,
      "turns": [
        {"role": "user", "content": "什么是机器学习？"},
        {"role": "user", "content": "你说的\"机器\"具体指什么？"},
        {"role": "user", "content": "那\"学\"呢？"},
        {"role": "user", "content": "你提到\"学习\"，学什么？怎么学？"},
        {"role": "user", "content": "你说的\"数据\"是什么数据？"},
        {"role": "user", "content": "具体是哪些数据？"}
      ],
      "expected_after_rounds": "snarky_or_terminate"
    },
